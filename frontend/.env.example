# Salin menjadi .env.local lalu isi nilainya. Jangan commit .env.local.

# true = pakai data mock di src/lib/mock, false = pakai Supabase
NEXT_PUBLIC_USE_MOCK=true

# Dari Supabase Dashboard > Project Settings > API (minta ke anggota backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL frontend, dipakai untuk link persetujuan orang tua
NEXT_PUBLIC_SITE_URL=http://localhost:3000
