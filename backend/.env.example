# Salin menjadi .env lalu isi nilainya. Jangan commit .env.
# Untuk Edge Function, simpan nilai ini dengan `supabase secrets set`, bukan di repo.

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Rahasia. Hanya untuk Edge Function dan skrip admin, tidak pernah untuk frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Password akun demo untuk skrip lokal (`npm run seed:akun`, `demo:reset`, `test:rls`)
DEMO_USER_PASSWORD=DemoSeventX123!

# Google Meet REST API (akun Google milik platform, lihat PRD bagian 9)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# AI Chatbot "Kiko" (Edge Function `chat` & script `ingest:knowledge`)
# Primary LLM: Agnes AI (agnes-3.0-flash) | Fallback: Gemini (gemini-3.8-flash) | Embedding: gemini-embedding-001
AGNES_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
